<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="FinPulse Windows"
           Manufacturer="Dhruv Gupta"
           Version="1.0.0"
           UpgradeCode="E3A74A3D-5D9E-40F6-96D2-4B283A499701"
           Scope="perMachine">
    
    <MajorUpgrade AllowDowngrades="yes" />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FinPulse Windows">
        <Files Include="publish\win-x64\*" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="AppShortcutComponent" Guid="D2A681BF-B85E-4D23-96CD-9E11C4F98E12" Bitness="always64">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="FinPulse Windows"
                  Description="FinPulse Windows Financial Suite"
                  Target="[INSTALLFOLDER]FinPulse.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\FinPulse" Name="installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder">
      <Component Id="AppDesktopShortcutComponent" Guid="F4B892CF-A71E-4122-8A4D-7E22D3E89F34" Bitness="always64">
        <Shortcut Id="ApplicationDesktopShortcut"
                  Name="FinPulse Windows"
                  Description="FinPulse Windows Financial Suite"
                  Target="[INSTALLFOLDER]FinPulse.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\FinPulse" Name="desktop_installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="MainFeature" Title="FinPulse Windows" Level="1">
      <Files Include="publish\win-x64\*" />
      <ComponentRef Id="AppShortcutComponent" />
      <ComponentRef Id="AppDesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
