<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="FinPulse Windows"
           Manufacturer="Dhruv Gupta"
           Version="1.0.0"
           UpgradeCode="E3A74A3D-5D9E-40F6-96D2-4B283A499701"
           Scope="perMachine">
    
    <MajorUpgrade DowngradeErrorMessage="!(loc.DowngradeError)" />
    
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="FinPulse Windows">
        <Component Id="MainExecutable" Guid="3E47A9D5-3E77-4467-A964-1A53EFDA6601" Bitness="always64">
          <File Id="FinPulseExe" Source="publish\win-x64\FinPulse.exe" KeyPath="yes">
            <Shortcut Id="FinPulseAppShortcut"
                      Directory="ProgramMenuFolder"
                      Name="FinPulse Windows"
                      Description="FinPulse Windows Financial Suite"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon.exe"
                      IconIndex="0"
                      Advertise="yes" />
            <Shortcut Id="FinPulseDesktopShortcut"
                      Directory="DesktopFolder"
                      Name="FinPulse Windows"
                      Description="FinPulse Windows Financial Suite"
                      WorkingDirectory="INSTALLFOLDER"
                      Icon="AppIcon.exe"
                      IconIndex="0"
                      Advertise="yes" />
          </File>
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Icon Id="AppIcon.exe" SourceFile="publish\win-x64\FinPulse.exe" />

    <Feature Id="MainFeature" Title="FinPulse Windows" Level="1">
      <ComponentRef Id="MainExecutable" />
    </Feature>

    <ui:WixUI Id="WixUI_Minimal" />
  </Package>
</Wix>
