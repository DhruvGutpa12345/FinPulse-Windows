<Page
    x:Class="FinPulse.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:converters="using:FinPulse.Common.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="32,20,32,48" MaxWidth="1040">

            <!-- PAGE HEADER -->
            <StackPanel Spacing="4">
                <TextBlock
                    Text="Settings"
                    Style="{ThemeResource TitleTextBlockStyle}"
                    FontWeight="SemiBold" />
                <TextBlock
                    Text="Customize appearance, backdrop materials, currency formatting, calculation engine defaults, and diagnostics."
                    Style="{ThemeResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!-- LIVE PREVIEW CARD -->
            <Border
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource SystemAccentColor}"
                BorderThickness="1.5"
                CornerRadius="8"
                Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE890;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock Text="LIVE PREVIEW &amp; ACTIVE STATE" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource SystemAccentColor}" FontWeight="Bold" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind ViewModel.FormattedSampleCurrency, Mode=OneWay}" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                        <StackPanel Orientation="Horizontal" Spacing="16">
                            <TextBlock Text="{x:Bind ViewModel.ActiveThemeDescription, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <TextBlock Text="•" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ActiveBackdropDescription, Mode=OneWay}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6" HorizontalAlignment="Right">
                        <Button
                            Style="{ThemeResource AccentButtonStyle}"
                            Content="Apply &amp; Save Now"
                            Command="{x:Bind ViewModel.SaveSettingsCommand}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- STATUS INFO NOTIFICATION BAR -->
            <InfoBar
                IsOpen="{x:Bind HasStatusMessage, Mode=OneWay}"
                Severity="Success"
                Message="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" />

            <!-- SECTION 1: APPEARANCE & BACKDROP -->
            <StackPanel Spacing="10">
                <TextBlock Text="Appearance &amp; Window Material" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- App Theme Setting -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE790;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="App Theme" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Select whether FinPulse displays in Light, Dark, or System theme" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            Width="200"
                            SelectedIndex="{x:Bind ViewModel.ThemeIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Windows Default" />
                            <ComboBoxItem Content="Light" />
                            <ComboBoxItem Content="Dark" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- System Backdrop Material -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE771;" FontSize="20" Foreground="#3B82F6" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Backdrop Material" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Windows 11 Mica Alt, Mica translucent glass, or Desktop Acrylic" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            Width="200"
                            SelectedIndex="{x:Bind ViewModel.BackdropIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="Mica Alt (Default)" />
                            <ComboBoxItem Content="Mica" />
                            <ComboBoxItem Content="Desktop Acrylic" />
                            <ComboBoxItem Content="None (Solid)" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION 2: CURRENCY & LOCALE -->
            <StackPanel Spacing="10">
                <TextBlock Text="Currency &amp; Regional Formatting" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE8C7;" FontSize="20" Foreground="#10B981" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Display Currency" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Choose base currency symbol and Indian Lakhs/Crores vs International notation" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ComboBox
                            Grid.Column="2"
                            Width="240"
                            SelectedIndex="{x:Bind ViewModel.SelectedCurrencyIndex, Mode=TwoWay}">
                            <ComboBoxItem Content="₹ Indian Rupee (INR - ₹)" />
                            <ComboBoxItem Content="$ US Dollar (USD - $)" />
                            <ComboBoxItem Content="€ Euro (EUR - €)" />
                            <ComboBoxItem Content="£ British Pound (GBP - £)" />
                            <ComboBoxItem Content="¥ Japanese Yen (JPY - ¥)" />
                        </ComboBox>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION 3: CALCULATION ENGINE DEFAULTS -->
            <StackPanel Spacing="10">
                <TextBlock Text="Calculation &amp; Mathematical Defaults" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- Default SIP Return Rate -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE9D9;" FontSize="20" Foreground="#8B5CF6" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Default SIP Return Rate (%)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Baseline annualized return rate prefilled in SIP Wealth Planner" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            Width="160"
                            Minimum="1"
                            Maximum="50"
                            SmallChange="0.5"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.DefaultReturnRate, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                    </Grid>
                </Border>

                <!-- Default Loan Interest Rate -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE825;" FontSize="20" Foreground="#F59E0B" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Default Loan Interest Rate (%)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Baseline annual interest rate prefilled in Loan EMI calculator" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <NumberBox
                            Grid.Column="2"
                            Width="160"
                            Minimum="1"
                            Maximum="40"
                            SmallChange="0.25"
                            SpinButtonPlacementMode="Compact"
                            Value="{x:Bind ViewModel.DefaultLoanRate, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                    </Grid>
                </Border>

                <!-- Auto-sort Cash Flows -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE8CB;" FontSize="20" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Auto-Sort Cash Flows" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Automatically sort transactions chronologically before Newton-Raphson/Brent calculation" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            IsOn="{x:Bind ViewModel.AutoSortCashFlows, Mode=TwoWay}" />
                    </Grid>
                </Border>

                <!-- Include CSV Headers -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE896;" FontSize="20" Foreground="#10B981" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Include CSV Report Headers" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Add metadata header block with date and calculation parameters in CSV exports" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ToggleSwitch
                            Grid.Column="2"
                            IsOn="{x:Bind ViewModel.IncludeCsvHeaders, Mode=TwoWay}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION 4: DATA & MAINTENANCE -->
            <StackPanel Spacing="10">
                <TextBlock Text="Data &amp; Maintenance" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <!-- Clear Logs -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE74D;" FontSize="20" Foreground="#EF4444" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Clear Diagnostic Logs" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Purge temporary runtime diagnostic files from the system temp directory" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Clear Logs"
                            Command="{x:Bind ViewModel.ClearLogsCommand}" />
                    </Grid>
                </Border>

                <!-- Reset Defaults -->
                <Border
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon Grid.Column="0" Glyph="&#xE777;" FontSize="20" Foreground="#F59E0B" Margin="0,0,16,0" VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="Reset All Settings" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Restore appearance, currency formatting, and default calculation parameters" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <Button
                            Grid.Column="2"
                            Content="Reset Defaults"
                            Command="{x:Bind ViewModel.ResetDefaultsCommand}" />
                    </Grid>
                </Border>
            </StackPanel>

            <!-- SECTION 5: ABOUT FINPULSE WINDOWS -->
            <StackPanel Spacing="10">
                <TextBlock Text="About FinPulse Windows" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                <Border
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="22">
                    <StackPanel Spacing="16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <FontIcon Grid.Column="0" Glyph="&#xE8EF;" FontSize="40" Foreground="{ThemeResource SystemAccentColor}" Margin="0,0,20,0" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <TextBlock Text="FinPulse Windows" Style="{ThemeResource TitleTextBlockStyle}" FontWeight="Bold" />
                                    <Border Background="{ThemeResource SystemAccentColor}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                        <TextBlock Text="v1.2.3" Foreground="White" FontWeight="SemiBold" FontSize="11" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="Open-source native financial desktop calculator suite engineered for Windows 11." Style="{ThemeResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <TextBlock Text="{x:Bind ViewModel.RuntimeInfo}" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            </StackPanel>
                        </Grid>

                        <MenuFlyoutSeparator />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Spacing="2">
                                <TextBlock Text="Author: Dhruv Gupta" Style="{ThemeResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                                <TextBlock Text="Licensed under the MIT License • Fully open source" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>

                            <Button
                                Grid.Column="1"
                                Style="{ThemeResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.OpenGitHubCommand}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE8A7;" FontSize="14" />
                                    <TextBlock Text="GitHub Repository" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
