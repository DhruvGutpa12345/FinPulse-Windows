<Page
    x:Class="FinPulse.Views.EmiCalculatorPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    xmlns:models="using:FinPulse.Core.Models"
    xmlns:converters="using:FinPulse.Common.Converters"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:CurrencyFormatterConverter x:Key="CurrencyConverter" />
        <converters:PercentageFormatterConverter x:Key="PercentageConverter" />
        <converters:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter" />
        <converters:IntToDoubleConverter x:Key="IntToDoubleConverter" />
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="24" Padding="24,16,24,32" MaxWidth="1400">

            <!-- PAGE HEADER & ACTION TOOLBAR -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Spacing="4">
                    <TextBlock
                        Text="EMI &amp; Loan Amortization Schedule Calculator"
                        Style="{ThemeResource TitleTextBlockStyle}"
                        FontWeight="SemiBold" />
                    <TextBlock
                        Text="Accurately compute monthly loan repayments, total interest obligations, and the interest-saving impact of early prepayments."
                        Style="{ThemeResource BodyTextBlockStyle}"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>

                <!-- Action Toolbar -->
                <CommandBar
                    Grid.Column="1"
                    DefaultLabelPosition="Right"
                    Background="Transparent"
                    IsOpen="False">
                    <AppBarButton
                        Icon="Copy"
                        Label="Copy Summary"
                        ToolTipService.ToolTip="Copy summary KPIs to clipboard"
                        Command="{x:Bind ViewModel.CopySummaryCommand}" />
                    <AppBarButton
                        Icon="Share"
                        Label="Export CSV"
                        ToolTipService.ToolTip="Export amortization schedule to CSV"
                        Command="{x:Bind ViewModel.ExportCsvCommand}" />
                </CommandBar>
            </Grid>

            <!-- KPI SUMMARY METRIC CARDS -->
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.1*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Monthly EMI Card -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource LayerFillColorAltBrush}"
                    BorderBrush="{ThemeResource SystemAccentColor}"
                    BorderThickness="1.5"
                    CornerRadius="8"
                    Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE825;" FontSize="14" Foreground="{ThemeResource SystemAccentColor}" />
                            <TextBlock
                                Text="MONTHLY EMI"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Result.MonthlyEmi, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            FontWeight="Bold"
                            Foreground="{ThemeResource SystemAccentColor}" />
                        <TextBlock
                            Text="Monthly installment amount"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Principal Amount Card -->
                <Border
                    Grid.Column="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8D8;" FontSize="14" Foreground="#3B82F6" />
                            <TextBlock
                                Text="TOTAL PRINCIPAL"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Result.TotalPrincipal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            FontWeight="Bold" />
                        <TextBlock
                            Text="Original borrowed amount"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Total Interest Card -->
                <Border
                    Grid.Column="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xEA39;" FontSize="14" Foreground="#EF4444" />
                            <TextBlock
                                Text="TOTAL INTEREST"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Result.TotalInterest, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            FontWeight="Bold"
                            Foreground="#EF4444" />
                        <TextBlock
                            Text="{x:Bind ViewModel.Result.InterestToPrincipalRatio, Mode=OneWay, Converter={StaticResource PercentageConverter}}"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>

                <!-- Total Payable Card -->
                <Border
                    Grid.Column="3"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="18,14">
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE9D9;" FontSize="14" Foreground="#8B5CF6" />
                            <TextBlock
                                Text="TOTAL PAYABLE"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                FontWeight="SemiBold" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind ViewModel.Result.TotalAmount, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                            Style="{ThemeResource TitleTextBlockStyle}"
                            FontWeight="Bold" />
                        <TextBlock
                            Text="Principal + Interest sum"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- INPUT CONTROLS & CHARTS ROW -->
            <Grid ColumnSpacing="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="420" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- LEFT: Interactive Inputs Card -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="20">
                    <StackPanel Spacing="20">
                        <TextBlock Text="Loan Parameters" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                        <!-- Quick Loan Presets -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Loan Type Presets" Style="{ThemeResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Content="Home Loan" Click="OnHomeLoanPreset" Style="{ThemeResource AccentButtonStyle}" Padding="10,4" />
                                <Button Content="Car Loan" Click="OnCarLoanPreset" Padding="10,4" />
                                <Button Content="Personal Loan" Click="OnPersonalLoanPreset" Padding="10,4" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Principal Amount -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Loan Principal (₹)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.Principal, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <NumberBox
                                Value="{x:Bind ViewModel.Principal, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                                SpinButtonPlacementMode="Compact"
                                SmallChange="50000"
                                LargeChange="500000"
                                ValueChanged="OnInputValueChanged" />
                            <Slider
                                Minimum="50000"
                                Maximum="20000000"
                                StepFrequency="50000"
                                Value="{x:Bind ViewModel.Principal, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                                ValueChanged="OnSliderValueChanged" />
                        </StackPanel>

                        <!-- Annual Interest Rate -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Interest Rate (p.a.)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.AnnualInterestRate, Mode=OneWay, Converter={StaticResource PercentageConverter}}"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <NumberBox
                                Value="{x:Bind ViewModel.AnnualInterestRate, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                                SpinButtonPlacementMode="Compact"
                                SmallChange="0.25"
                                ValueChanged="OnInputValueChanged" />
                            <Slider
                                Minimum="5"
                                Maximum="25"
                                StepFrequency="0.25"
                                Value="{x:Bind ViewModel.AnnualInterestRate, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                                ValueChanged="OnSliderValueChanged" />
                        </StackPanel>

                        <!-- Loan Tenure (Years) -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Tenure (Years)" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.TenureYears, Mode=OneWay}"
                                    HorizontalAlignment="Right"
                                    Foreground="{ThemeResource SystemAccentColor}"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <NumberBox
                                Value="{x:Bind ViewModel.TenureYears, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}"
                                SpinButtonPlacementMode="Compact"
                                SmallChange="1"
                                ValueChanged="OnInputValueChanged" />
                            <Slider
                                Minimum="1"
                                Maximum="35"
                                StepFrequency="1"
                                Value="{x:Bind ViewModel.TenureYears, Mode=TwoWay, Converter={StaticResource IntToDoubleConverter}}"
                                ValueChanged="OnSliderValueChanged" />
                        </StackPanel>

                        <!-- Optional Extra Monthly Prepayment -->
                        <StackPanel Spacing="8">
                            <Grid>
                                <TextBlock Text="Extra Monthly Prepayment" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.ExtraMonthlyPayment, Mode=OneWay, Converter={StaticResource CurrencyConverter}}"
                                    HorizontalAlignment="Right"
                                    Foreground="#10B981"
                                    FontWeight="SemiBold" />
                            </Grid>
                            <NumberBox
                                Value="{x:Bind ViewModel.ExtraMonthlyPayment, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}"
                                SpinButtonPlacementMode="Compact"
                                SmallChange="1000"
                                LargeChange="5000"
                                ValueChanged="OnInputValueChanged" />
                            <TextBlock
                                Text="Add regular prepayment to observe tenure reduction and interest savings"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- RIGHT: Charts Column -->
                <Grid Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" />
                        <RowDefinition Height="280" />
                    </Grid.RowDefinitions>

                    <!-- Chart 1: Principal vs Interest Doughnut -->
                    <Border
                        Grid.Row="0"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Total Loan Repayment Breakdown" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <lvc:PieChart
                                Grid.Row="1"
                                Series="{x:Bind ViewModel.PieSeries, Mode=OneWay}"
                                LegendPosition="Right" />
                        </Grid>
                    </Border>

                    <!-- Chart 2: Amortization Schedule Chart -->
                    <Border
                        Grid.Row="1"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Yearly Principal vs Interest Payment Amortization" FontWeight="SemiBold" Style="{ThemeResource BodyStrongTextBlockStyle}" />
                            <lvc:CartesianChart
                                Grid.Row="1"
                                Series="{x:Bind ViewModel.AmortizationSeries, Mode=OneWay}"
                                XAxes="{x:Bind ViewModel.AmortizationXAxes, Mode=OneWay}"
                                YAxes="{x:Bind ViewModel.AmortizationYAxes, Mode=OneWay}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- YEARLY AMORTIZATION SCHEDULE TABLE -->
            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="20">
                <StackPanel Spacing="16">
                    <TextBlock Text="Yearly Loan Amortization Schedule" FontWeight="SemiBold" Style="{ThemeResource SubtitleTextBlockStyle}" />

                    <!-- Header -->
                    <Grid Padding="12,8" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="YEAR" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="1" Text="PRINCIPAL PAID" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="2" Text="INTEREST PAID" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="3" Text="TOTAL PAID" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                        <TextBlock Grid.Column="4" Text="ENDING BALANCE" FontWeight="SemiBold" Style="{ThemeResource CaptionTextBlockStyle}" />
                    </Grid>

                    <!-- List -->
                    <ListView
                        ItemsSource="{x:Bind ViewModel.YearlySchedule, Mode=OneWay}"
                        SelectionMode="None"
                        MaxHeight="360">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:EmiYearlySummary">
                                <Grid Padding="12,10" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Year, Mode=OneWay}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind PrincipalPaid, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#3B82F6" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind InterestPaid, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" Foreground="#EF4444" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind TotalPaid, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="4" Text="{x:Bind EndingBalance, Mode=OneWay, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</Page>
